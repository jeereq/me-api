# Base PostgreSQL (Render, Neon, Railway, ou locale)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/me?schema=public"

# Obligatoire : clé longue et aléatoire pour signer les sessions (ex. `openssl rand -hex 32`)
JWT_SECRET=

PORT=4000

# Origines web autorisées, séparées par des virgules (l'app mobile n'en a pas besoin)
CORS_ORIGINS=http://localhost:8081

# Compte admin principal, créé au démarrage (le mot de passe suit cette variable à chaque redémarrage).
# Sans ces variables, le premier compte inscrit devient admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOM=

# Inscriptions ouvertes à tous ("true") ou fermées après le premier compte ("false")
SIGNUP_OPEN=true

# Assistant IA : la clé reste sur le serveur, jamais dans l'app
OPENAI_API_KEY=
# Modèle par défaut ; l'admin peut en choisir un autre dans l'app
OPENAI_MODEL=gpt-4o-mini
# Optionnel : autre point d'accès compatible OpenAI (proxy, Azure…)
OPENAI_BASE_URL=

# --- Rappels par email (SendGrid) ---
# app.sendgrid.com > Settings > API Keys (droit « Mail Send ») ; l'expéditeur doit être vérifié (Sender Authentication)
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_FROM_NAME=me

# --- Comptes connectés (Agendas & outils) ---
# Adresse publique de ce serveur : sert aux retours OAuth (ex. https://me-api.onrender.com)
PUBLIC_URL=http://localhost:4000
# Obligatoire pour connecter des comptes : chiffre les jetons en base (`openssl rand -hex 32`)
ENCRYPTION_KEY=
# Adresses de retour vers l'app acceptées en plus de me:// et exp:// (séparées par des virgules)
APP_REDIRECT_URLS=

# Google Agenda et Gmail : console.cloud.google.com > API et services > Identifiants (client OAuth « Application Web »)
# URI de redirection : {PUBLIC_URL}/api/integrations/google/callback ; activer Google Calendar API et Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook, Microsoft 365 et To Do : portal.azure.com > Inscriptions d'applications
# Comptes « personnels et professionnels », redirection Web : {PUBLIC_URL}/api/integrations/microsoft/callback
# Autorisations déléguées : Calendars.Read, Mail.Read, Tasks.Read, User.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Trello : trello.com/power-ups/admin > clé API ; ajouter {PUBLIC_URL} aux origines autorisées
TRELLO_API_KEY=

# Slack : api.slack.com/apps > OAuth & Permissions
# Redirect URL : {PUBLIC_URL}/api/integrations/slack/callback
# User Token Scopes : search:read, channels:history, groups:history, im:history, mpim:history
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
