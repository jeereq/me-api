generator client {
  provider      = "prisma-client-js"
  /// Binaire Linux pour l'hébergement (OpenSSL 3).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  UTILISATEUR
}

/// Un compte « me ». Le premier compte créé devient admin.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Absent pour un compte créé avec Google (sans mot de passe).
  passwordHash String?
  nom          String   @default("")
  /// Adresse confirmée par le lien reçu par email (ou par Google).
  emailVerifie Boolean  @default(false)
  /// Identifiant Google (« sub ») pour « Continuer avec Google ».
  googleId     String?  @unique
  /// Dernier changement de mot de passe : les sessions ouvertes avant sont refusées.
  motDePasseLe DateTime?
  /// « Déconnecter tous mes appareils » : les sessions ouvertes avant sont refusées.
  sessionsLe   DateTime?
  role         Role     @default(UTILISATEUR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Fuseau IANA du téléphone (ex. Europe/Paris), pour placer les rendez-vous importés à la bonne heure.
  fuseau       String   @default("UTC")
  /// Fin de l'essai Pro gratuit (14 jours à l'inscription). Voir src/services/abonnements/offres.ts.
  essaiJusqua  DateTime?
  /// Abonnement Pro prépayé : période choisie au dernier paiement, et fin de la période payée (sans renouvellement automatique).
  abonnementPeriode  String?
  abonnementFinLe    DateTime?
  /// Acceptation des conditions générales de vente au moment du paiement, et leur version.
  cgvAccepteesLe     DateTime?
  cgvVersion         String?
  espace       Espace?
  integrations Integration[]
  notifications Notification[]
  abonnementsPush PushAbonnement[]
  jetons       JetonCompte[]
  equipes      EquipeMembre[]
  paiements    Paiement[]
  analysesMails AnalyseMail[]
}

/// L'espace privé d'un compte : relances, tâches, habitudes, contacts, journal, agenda, sources, audio.
/// Stocké en un seul document JSON, lu et écrit uniquement par son propriétaire.
model Espace {
  userId String   @id
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data   Json
  majLe  DateTime @default(now())
  /// Numéro de version, +1 à chaque écriture : un appareil qui écrit sur une version périmée est refusé (409) au lieu d'écraser.
  revision Int    @default(0)
}

/// Verrou de tâche planifiée : une seule instance du serveur exécute un passage à la fois.
model VerrouCron {
  nom     String   @id
  /// Identifiant de l'instance qui tient le verrou : elle seule peut le relâcher.
  porteur String
  /// Fin du bail ; passé ce délai, une autre instance peut reprendre (instance tombée en route).
  jusqua  DateTime
}

/// Configuration système (ligne unique id = 1) : lisible par tous les comptes, modifiable par les admins.
model Config {
  id     Int      @id @default(1)
  data   Json
  majLe  DateTime @updatedAt
  majPar String?
}

enum Fournisseur {
  GOOGLE
  MICROSOFT
  TRELLO
  SLACK
}

/// Un compte externe connecté (plusieurs par fournisseur possibles : Gmail perso et Google Workspace pro, par exemple).
/// Les jetons sont chiffrés (AES-256-GCM, clé ENCRYPTION_KEY).
model Integration {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fournisseur   Fournisseur
  /// Email ou nom du compte externe
  compte        String
  /// perso ou pro : contexte des éléments importés
  ctx           String      @default("perso")
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  /// Réglages du compte : { agendas: [ids des agendas à synchroniser] }
  prefs         Json?
  /// Derniers éléments importés : { agenda, taches, relances, mails }
  donnees       Json?
  derniereSync  DateTime?
  erreur        String?
  createdAt     DateTime    @default(now())
  analysesMails AnalyseMail[]

  @@unique([userId, fournisseur, compte])
  @@index([userId])
}

/// Rappel envoyé à un compte : visible dans l'app (centre de notifications) et, si activé, par email.
model Notification {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identifiant du rappel (jour, heure, élément) : un rappel n'est jamais envoyé deux fois.
  cle     String
  titre   String
  corps   String
  mode    String
  /// Heure locale prévue, « AAAA-MM-JJTHH:MM »
  quand   String
  lu      Boolean  @default(false)
  parEmail Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, cle])
  @@index([userId, createdAt])
}

/// Un navigateur ou une app web installée qui reçoit les rappels même fermée (Web Push).
model PushAbonnement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  appareil  String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TypeJeton {
  VERIFICATION
  REINITIALISATION
  CONNEXION
}

/// Lien à usage unique envoyé par email (confirmation, nouveau mot de passe) ou code de retour de « Continuer avec Google ».
/// Seule l'empreinte SHA-256 du jeton est gardée.
model JetonCompte {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TypeJeton
  empreinte String    @unique
  expireLe  DateTime
  utiliseLe DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

enum RoleEquipe {
  PROPRIETAIRE
  MEMBRE
  LECTEUR
}

/// Une équipe : des comptes « me » qui partagent un espace (budgets, objectifs, projets, tâches, habitudes).
model Equipe {
  id          String   @id @default(cuid())
  nom         String
  emoji       String   @default("👥")
  createdAt   DateTime @default(now())
  membres     EquipeMembre[]
  invitations InvitationEquipe[]
  espace      EspaceEquipe?
}

/// Un compte dans une équipe, avec ce qu'il y a le droit de faire.
model EquipeMembre {
  id       String     @id @default(cuid())
  equipeId String
  equipe   Equipe     @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     RoleEquipe @default(MEMBRE)
  depuisLe DateTime   @default(now())

  @@unique([equipeId, userId])
  @@index([userId])
}

/// Invitation à rejoindre une équipe : un lien à usage unique, envoyé à une adresse email, qui expire.
/// Seule l'empreinte SHA-256 du jeton est gardée, comme pour les liens de compte.
model InvitationEquipe {
  id        String     @id @default(cuid())
  equipeId  String
  equipe    Equipe     @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  /// Adresse invitée, en minuscules : seul le compte qui porte cette adresse peut accepter.
  email     String
  role      RoleEquipe @default(MEMBRE)
  empreinte String     @unique
  /// Qui a invité (gardé même si le compte part de l'équipe).
  parNom    String     @default("")
  expireLe  DateTime
  utiliseLe DateTime?
  /// Dernière ouverture du lien (aperçu dans l'app) et adresse du compte qui l'a ouvert : montre au propriétaire qu'une personne a cliqué, et avec quel compte.
  ouverteLe  DateTime?
  ouvertePar String?
  createdAt DateTime   @default(now())

  @@index([equipeId])
  @@index([email])
}

/// L'espace partagé d'une équipe : un document JSON et les mêmes révisions que l'espace privé.
model EspaceEquipe {
  equipeId String   @id
  equipe   Equipe   @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  data     Json
  majLe    DateTime @default(now())
  /// Numéro de version, +1 à chaque écriture : un appareil qui écrit sur une version périmée est refusé (409).
  revision Int      @default(0)
}

/// Un paiement d'abonnement Pro par FlexPaie (mobile money). Il prolonge abonnementFinLe une fois confirmé.
/// À la suppression du compte, il reste pour la comptabilité, détaché du compte et sans numéro de téléphone.
model Paiement {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Référence envoyée à FlexPaie, unique : un paiement n'est jamais compté deux fois.
  reference String    @unique
  /// mensuel ou annuel
  periode   String
  /// Montant en centimes, et sa devise (USD, CDF).
  montant   Int
  devise    String
  telephone String    @default("")
  /// en_attente, paye, echoue (refusé par FlexPaie), expire (pas de réponse en 24 h) ou abandonne (par le client).
  /// expire et abandonne restent revérifiés pendant 7 jours : un paiement validé en retard ouvre quand même Pro.
  statut    String    @default("en_attente")
  /// Numéro de commande renvoyé par FlexPaie, pour vérifier le paiement chez eux.
  commande  String?
  message   String?
  payeLe    DateTime?
  /// Version des CGV acceptées et demande d'accès immédiat pour ce paiement : chaque période est un contrat.
  cgvVersion    String?
  accesImmediat Boolean @default(false)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([statut, createdAt])
}

/// Empreinte (HMAC) de l'email ou de l'identifiant Google d'un compte supprimé qui a eu son essai Pro.
/// Sert seulement à ne pas redonner l'essai à la même personne. Voir src/services/abonnements/essai-unique.ts.
model EssaiUtilise {
  empreinte String   @id
  createdAt DateTime @default(now())
}

/// Un justificatif de dépense (photo de reçu, PDF de facture) déposé chez Cloudinary par me-api.
/// La fiche affichée vit dans la dépense de l'espace ; cette ligne sert au ménage : un fichier qu'aucun espace
/// ne mentionne plus est effacé de Cloudinary (voir src/services/justificatifs/stock.ts).
/// Sans relation au compte : à sa suppression, ses fichiers sont effacés avant les lignes.
model Justificatif {
  /// Identifiant Cloudinary (public_id), repris dans la dépense.
  publicId  String    @id
  /// Type de ressource Cloudinary : image (photos et PDF) ou raw.
  genre     String    @default("image")
  /// Qui l'a déposé.
  userId    String
  /// Espace d'équipe où vit la dépense ; absent = espace privé de `userId`.
  equipeId  String?
  /// Dernière fois que le ménage l'a trouvé encore utilisé.
  verifieLe DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([equipeId])
  @@index([createdAt])
}

/// L'analyse d'un mail par le copilote (résumé, urgence, réponse proposée…), gardée 30 jours pour ne pas la refaire à chaque
/// ouverture et pour la préparer à l'avance (voir src/services/AnalyseMailService.ts). Le texte du mail n'est pas gardé.
/// Supprimée avec le compte connecté ou le compte me, et par le ménage de nuit passé 30 jours.
model AnalyseMail {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// Identifiant du mail chez le service (celui de MailImporte.id).
  mailId        String
  /// Empreinte de ce qui a été demandé (ton, consignes, version de l'analyse) : une autre demande refait l'analyse.
  empreinte     String
  /// Modèles qui ont répondu (« gpt-4o-mini » ou « gpt-4o-mini+gpt-4.1 »).
  modele        String
  /// L'analyse telle que l'IA l'a rendue (un objet de la liste « analyses »).
  resultat      Json
  createdAt     DateTime    @default(now())
  majLe         DateTime    @default(now()) @updatedAt

  @@unique([integrationId, mailId])
  @@index([userId])
  @@index([majLe])
}
