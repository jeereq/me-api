generator client {
  provider      = "prisma-client-js"
  /// Binaire Linux pour l'hébergement (OpenSSL 3).
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  UTILISATEUR
}

/// Un compte « me ». Le premier compte créé devient admin.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Absent pour un compte créé avec Google (sans mot de passe).
  passwordHash String?
  nom          String   @default("")
  /// Adresse confirmée par le lien reçu par email (ou par Google).
  emailVerifie Boolean  @default(false)
  /// Identifiant Google (« sub ») pour « Continuer avec Google ».
  googleId     String?  @unique
  /// Dernier changement de mot de passe : les sessions ouvertes avant sont refusées.
  motDePasseLe DateTime?
  role         Role     @default(UTILISATEUR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Fuseau IANA du téléphone (ex. Europe/Paris), pour placer les rendez-vous importés à la bonne heure.
  fuseau       String   @default("UTC")
  espace       Espace?
  integrations Integration[]
  notifications Notification[]
  abonnementsPush PushAbonnement[]
  jetons       JetonCompte[]
}

/// L'espace privé d'un compte : relances, tâches, habitudes, contacts, journal, agenda, sources, audio.
/// Stocké en un seul document JSON, lu et écrit uniquement par son propriétaire.
model Espace {
  userId String   @id
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data   Json
  majLe  DateTime @default(now())
}

/// Configuration système (ligne unique id = 1) : lisible par tous les comptes, modifiable par les admins.
model Config {
  id     Int      @id @default(1)
  data   Json
  majLe  DateTime @updatedAt
  majPar String?
}

enum Fournisseur {
  GOOGLE
  MICROSOFT
  TRELLO
  SLACK
}

/// Un compte externe connecté (plusieurs par fournisseur possibles : Gmail perso et Google Workspace pro, par exemple).
/// Les jetons sont chiffrés (AES-256-GCM, clé ENCRYPTION_KEY).
model Integration {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fournisseur   Fournisseur
  /// Email ou nom du compte externe
  compte        String
  /// perso ou pro : contexte des éléments importés
  ctx           String      @default("perso")
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  /// Derniers éléments importés : { agenda, taches, relances }
  donnees       Json?
  derniereSync  DateTime?
  erreur        String?
  createdAt     DateTime    @default(now())

  @@unique([userId, fournisseur, compte])
  @@index([userId])
}

/// Rappel envoyé à un compte : visible dans l'app (centre de notifications) et, si activé, par email.
model Notification {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Identifiant du rappel (jour, heure, élément) : un rappel n'est jamais envoyé deux fois.
  cle     String
  titre   String
  corps   String
  mode    String
  /// Heure locale prévue, « AAAA-MM-JJTHH:MM »
  quand   String
  lu      Boolean  @default(false)
  parEmail Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, cle])
  @@index([userId, createdAt])
}

/// Un navigateur ou une app web installée qui reçoit les rappels même fermée (Web Push).
model PushAbonnement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  appareil  String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TypeJeton {
  VERIFICATION
  REINITIALISATION
  CONNEXION
}

/// Lien à usage unique envoyé par email (confirmation, nouveau mot de passe) ou code de retour de « Continuer avec Google ».
/// Seule l'empreinte SHA-256 du jeton est gardée.
model JetonCompte {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TypeJeton
  empreinte String    @unique
  expireLe  DateTime
  utiliseLe DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}
